<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Wpf="clr-namespace:Alternet.Editor.Wpf;assembly=Alternet.Editor.Wpf.v11" x:Class="XmlParsing.MainWindow"
        xmlns:local="clr-namespace:XmlParsing"
        Icon="/XmlParsing.Wpf;component/Images/Icon.Ico" 
        Title="Xml Parsing" Height="400" Width="679" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="27"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label x:Name="laDescription" Grid.Column="0" Grid.Row="0">
            <AccessText TextWrapping="Wrap" Text="This demo shows advanced code-editing capabilities, including Code Outlining, Code Completion, and syntax error checking for the XML language. These features are driven by an XSD schema definition."/>
        </Label>
        <Label Grid.Column="0" Grid.Row="1" Content="Xml:" Width="70" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="1" Margin="70,0,0,0">
            <ComboBox Width="121" Height="21" Name="XmlsComboBox" ItemsSource="{Binding Path=Xmls}" SelectedItem="{Binding Xml}" ToolTip="Choose Xml"/>
        </StackPanel>
        <Button Height="21" Grid.Column="0" Grid.Row="1" Content="Load" HorizontalAlignment="Right"  Margin="310,0,10,0" Width="85" HorizontalContentAlignment="Center" Command="{Binding LoadCommand}" ToolTip="Load code file"/>
        <Wpf:TextEditor Grid.Column="0" Grid.Row="3" Name="syntaxEdit1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0" AllowOutlining="True"/>
    </Grid>
</Window>