<Window xmlns="http://schemas.alternetsoft.com/ui/2021"
        xmlns:x="http://schemas.alternetsoft.com/ui/2021/uixml"
        xmlns:editor="http://schemas.alternetsoft.com/editor/2024"
        x:Class="MemoryAssembly.Python.Form1"
        Title="Memory Assembly on Alternet.UI" StartLocation="CenterScreen"
        MinimumSize="600, 400" Size="900,700" Layout="Vertical" Padding="10"
        Icon="embres:MemoryAssembly.Python.Sample.ico">

  <Panel Name="pnSettings" Layout="Vertical" Padding = "5">
    <Panel Name="pnDescription" Layout="Vertical" Padding = "5">
      <Label Name="lbDescription"
             Text="This demo shows how to use memory assemblies in scripting."/>
		<Button Name="ScriptButton" Text="Run Script"
				HorizontalAlignment = "Left" VerticalAlignment="Center"/>
	</Panel>
  </Panel>

  <TabControl VerticalAlignment="Fill">
    <TabPage Title="Source Code">
        <editor:SyntaxEdit Name="edit" WordWrap = "true"/>
    </TabPage>
    <TabPage Title="External Code">
        <editor:SyntaxEdit Name="editExt" WordWrap = "true"/>
    </TabPage>
  </TabControl>
  
</Window>