<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>Sample.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DebuggerIntegration.Python.AlternetUI</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Content\**" />
    <Compile Remove="Resources\**" />
    <EmbeddedResource Remove="Content\**" />
    <EmbeddedResource Remove="Resources\**" />
    <None Remove="Content\**" />
    <None Remove="Resources\**" />
    <UIXml Remove="Content\**" />
    <UIXml Remove="Resources\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Sample.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Sample.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Alternet.Studio.Common.AlternetUI" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Common" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Common.Python" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Editor.AlternetUI" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Editor.Common.AlternetUI" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Integration.AlternetUI" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Syntax" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Syntax.Parsers.Advanced.Python" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Python" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Debugger.Python" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Python.Embedded" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Common" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Debugger.Common" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Debugger.UI.AlternetUI" Version="11.0.0" />
    <PackageReference Include="Alternet.UI" Version="1.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties/" />
  </ItemGroup>
</Project>