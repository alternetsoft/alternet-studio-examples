<Window xmlns="http://schemas.alternetsoft.com/ui/2021"
        xmlns:x="http://schemas.alternetsoft.com/ui/2021/uixml"
        xmlns:editor="http://schemas.alternetsoft.com/editor/2024"
        x:Class="TypeScriptParsing.Form1"
        Title="Editor TypeScript Parsing on Alternet.UI" StartLocation="CenterScreen"
        MinimumSize="600, 400" Size="900,700" Layout="Vertical" Padding="5"
        Icon="embres:TypeScriptParsing.Sample.ico">

  <Panel Name="pnSettings" Layout="Vertical" Padding = "5">
    <Panel Name="pnDescription" Layout="Vertical" Padding = "5">
      <Label Name="lbDescription"
             Text="This demo shows how to use the dedicated parsers for Javascript/Typescript languages based on Microsoft ClearScript. This parser supports automatic code completion, code outlining, smart formatting, and syntax error underlining."/>
    </Panel>

    <Panel Name="pnLanguages" Layout="Horizontal" Padding = "5">
      <Label Name="lbLanguages" Text="Language:" VerticalAlignment="Center" Margin="5"/>

      <ListPicker Name="cbLanguages" Margin="5" VerticalAlignment="Center"
          ToolTip = "Choose programming language"/>
		<CheckBox Name="customHighlightingCheckBox" RowColumn="1,0" Text="Semantic Highlighting"
				  ToolTip = ""
				  Margin="0,0,5,0"/>
		<Button Name="btLoad" Text = "Load" HorizontalAlignment = "Right"
          ToolTip = "Load code file" Margin="5"  VerticalAlignment="Center"/>
    </Panel>
  </Panel>

  <Border VerticalAlignment="Fill" Margin="5">
    <editor:SyntaxEdit Name="syntaxEdit1" WordWrap = "true" />
  </Border>
</Window>

