<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
  </ItemGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
    <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
    <OutputType>Exe</OutputType>
    <RootNamespace>DebuggerIntegration</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <AssemblyName>DebuggerIntegration.Python.MAUI</AssemblyName>
    <OutputName>$(AssemblyName)</OutputName>
    <!-- Display name
ApplicationTitle is a property that sets the "display name" or user-visible title of your application on some platforms.
It is not the same as <AssemblyName>, which affects output binary file names.
For .NET MAUI and Xamarin.Forms, ApplicationTitle's direct effect is mostly on Windows targets—it controls the
 friendly name shown in the Windows Start Menu and window title.
 -->
    <ApplicationTitle>AlterNET Debugger Integration for Python</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.AlterNET.debuggerintegrationPython</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Content\DebuggerTest\**" />
    <EmbeddedResource Remove="Content\DebuggerTest\**" />
    <MauiCss Remove="Content\DebuggerTest\**" />
    <MauiXaml Remove="Content\DebuggerTest\**" />
    <None Remove="Content\DebuggerTest\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Alternet.Studio.Common.AlternetUI" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Common" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Common.Python" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Editor.MAUI" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Editor.AlternetUI" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Editor.Common.AlternetUI" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Integration.MAUI" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Syntax" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Syntax.Parsers.Advanced.Python" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Python" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Debugger.Python" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Common" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Debugger.Common" Version="11.0.0" />
    <PackageReference Include="Alternet.Studio.Scripter.Debugger.UI.MAUI" Version="11.0.0" />
    <PackageReference Include="Alternet.UI.Maui" Version="1.1.0" />
  </ItemGroup>
  <ItemGroup>
    <PRIResource Remove="Content\DebuggerTest\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Content\MyModule.py" />
    <None Remove="Content\ScriptSimple.py" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Content\MyModule.py" />
    <EmbeddedResource Include="Content\ScriptSimple.py" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Content\Project.pyproj" />
  </ItemGroup>
</Project>